NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# false にすると新規登録 / Google ログインの導線をそれぞれ非表示にする。
# 未設定時は従来どおり表示。公開登録を無効にした認証サーバーでは前者を false、
# Google OAuth が未設定なら後者を false にする。変更後は frontend の再ビルドが必要。
# これらは表示設定であり、登録の許可は認証サーバー側でも制限する。
NEXT_PUBLIC_AUTH_ALLOW_SIGNUP=true
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true

# ローカルで Next.js と API に個別接続する場合。末尾に / を付けない。
# Mac の同一オリジン reverse proxy 経由では両方を空欄にする。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/chat
# 本番発表用のデモボタンを表示する場合だけ true
NEXT_PUBLIC_PRESENTATION_DEMO_MODE=false

# Push購読作成時に使用
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
