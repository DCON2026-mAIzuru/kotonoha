# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
# Optional: バックエンドでJWTをローカル検証する場合に使用
SUPABASE_JWT_SECRET=

# Backend
BACKEND_HOST=
BACKEND_PORT=8080
BACKEND_ALLOWED_ORIGIN=http://localhost:3000
SENSOR_SHARED_TOKEN=
PRESENTATION_DEMO_MODE=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/chat
# 本番発表用のデモボタンをフロントに表示する場合だけ true
NEXT_PUBLIC_PRESENTATION_DEMO_MODE=false

# Local DL image diagnosis
DL_SERVICE_URL=http://127.0.0.1:8090
DL_SERVICE_TIMEOUT_SECONDS=90
DIAGNOSIS_MAX_IMAGE_MB=8
DIAGNOSIS_ARTIFACT_DIR=/tmp/kotonoha-diagnosis-artifacts

# AI
# Colab の OpenAI 互換 API は openai-compatible を指定。
# gemini は GEMINI_API_KEY 必須。disabled は未接続エラーを返す。
# 固定返答は明示的な fallback のみ。
LLM_PROVIDER=gemini
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
# 会話生成とは別設定。disabled でも通常の会話履歴は保存する。
# Gemini API キーがなければ未指定の既定値も disabled。
EMBEDDING_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
