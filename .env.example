# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
# Optional: バックエンドでJWTをローカル検証する場合に使用
SUPABASE_JWT_SECRET=

# Backend
BACKEND_PORT=8080
BACKEND_ALLOWED_ORIGIN=http://localhost:3000
SENSOR_SHARED_TOKEN=
PRESENTATION_DEMO_MODE=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/chat
# 本番発表用のデモボタンをフロントに表示する場合だけ true
NEXT_PUBLIC_PRESENTATION_DEMO_MODE=false

# Local DL image diagnosis
DL_SERVICE_URL=http://127.0.0.1:8090
DL_SERVICE_TIMEOUT_SECONDS=90
DIAGNOSIS_MAX_IMAGE_MB=8
DIAGNOSIS_ARTIFACT_DIR=/tmp/kotonoha-diagnosis-artifacts

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
